{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "sound-space",
      "version": "1.0.0",
      "title": "sound-space"
    },
    "tools": [
      {
        "name": "list_songs",
        "title": "List songs",
        "description": "List songs in the library with optional search and filters.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Match title or artist (case-insensitive)."
            },
            "genre": {
              "type": "string"
            },
            "mood": {
              "type": "string"
            },
            "include_trash": {
              "type": "boolean",
              "description": "Include soft-deleted songs."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_song",
        "title": "Get song",
        "description": "Get full details for one song, including prompt, lyrics and quality metadata.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Song ID."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_song",
        "title": "Update song metadata",
        "description": "Edit a song's title, artist, genre, mood, prompt, lyrics, BPM, key, time signature or cover URL.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "artist": {
              "type": "string",
              "minLength": 1
            },
            "genre": {
              "type": [
                "string",
                "null"
              ]
            },
            "mood": {
              "type": [
                "string",
                "null"
              ]
            },
            "prompt": {
              "type": [
                "string",
                "null"
              ]
            },
            "lyrics": {
              "type": [
                "string",
                "null"
              ]
            },
            "bpm": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "key_scale": {
              "type": [
                "string",
                "null"
              ]
            },
            "time_signature": {
              "type": [
                "string",
                "null"
              ]
            },
            "cover_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "quality_score": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_song",
        "title": "Delete song (trash)",
        "description": "Soft-delete a song. It stays in trash for 30 days and can be restored.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "restore_song",
        "title": "Restore song",
        "description": "Restore a soft-deleted song from trash back into the library.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_playlists",
        "title": "List playlists",
        "description": "List all playlists with song counts.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_playlist_songs",
        "title": "Get playlist songs",
        "description": "List the songs in a playlist, in order.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "playlist_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "playlist_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_playlist",
        "title": "Create playlist",
        "description": "Create a new playlist.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "cover_image_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_playlist",
        "title": "Update playlist",
        "description": "Rename a playlist or change its description or cover.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "cover_image_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_playlist",
        "title": "Delete playlist",
        "description": "Delete a playlist and its song links. Songs themselves are kept in the library.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_song_to_playlist",
        "title": "Add song to playlist",
        "description": "Add a song to the end of a playlist.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "playlist_id": {
              "type": "string",
              "format": "uuid"
            },
            "song_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "playlist_id",
            "song_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "remove_song_from_playlist",
        "title": "Remove song from playlist",
        "description": "Remove a song from a playlist. The song stays in the library.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "playlist_id": {
              "type": "string",
              "format": "uuid"
            },
            "song_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "playlist_id",
            "song_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "library_stats",
        "title": "Library stats",
        "description": "Get totals: songs, trashed songs, playlists, and genre/mood distribution.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
